# Copy to .env and fill in. Never commit .env.
NOVERA_PLATFORM_NAME=Novera
NOVERA_REPORTING_CURRENCY=USD
NOVERA_DATA_DIR=./data
NOVERA_DB_PATH=./data/novera.duckdb
NOVERA_FUND_DB_PATH=./data/fund.duckdb
# LLM provider for the Risk Copilot. The engine never depends on this.
ANTHROPIC_API_KEY=
NOVERA_LLM_MODEL=claude-opus-5

# Alerts: stored in the database always; delivered only if a channel is configured.
# WARNING: every `novera run eod` and the scheduler deliver for real once SMTP/Slack is filled in.
NOVERA_ALERTS_ENABLED=true
NOVERA_SLACK_WEBHOOK_URL=
NOVERA_SMTP_HOST=
NOVERA_SMTP_PORT=587
NOVERA_SMTP_USER=
NOVERA_SMTP_PASSWORD=
NOVERA_ALERT_EMAIL_FROM=
NOVERA_ALERT_EMAIL_TO=

# Scheduler: wall-clock time for the daily EOD run.
NOVERA_EOD_TIME=18:30

# Real market data (optional). FRED key is free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Counterparty risk.
NOVERA_EXPOSURE_ENABLED=true
NOVERA_EXPOSURE_PATHS=1000
NOVERA_OWN_CREDIT_SPREAD_BP=80
NOVERA_LGD=0.6
NOVERA_REGULATORY_ENABLED=true
