# Copy to .env and fill in. Never commit .env.
NOVERA_PLATFORM_NAME=Novera
NOVERA_REPORTING_CURRENCY=USD
NOVERA_DATA_DIR=./data
NOVERA_DB_PATH=./data/novera.duckdb
NOVERA_FUND_DB_PATH=./data/fund.duckdb
# LLM provider for Novera Analyst and the agents. The engine never depends on this.
# NOVERA_LLM_PROVIDER: one provider, or a comma-separated chain tried in order; a provider
# that runs out of quota, is down or rejects the key is skipped for the next one.
# auto = every provider with a key, in the order Anthropic (paid), Gemini, Groq, OpenRouter;
# with no key at all, NOVERA_LLM_BASE_URL, else the scripted stand-in (no key).
# A member may carry its own model after a colon: openrouter:google/gemma-4-31b-it:free
NOVERA_LLM_PROVIDER=gemini,groq,openrouter,ollama
ANTHROPIC_API_KEY=
GEMINI_API_KEY=           # free at https://aistudio.google.com/apikey (rate limited; Google may train on free-tier prompts)
GROQ_API_KEY=             # free at https://console.groq.com/keys
OPENROUTER_API_KEY=       # https://openrouter.ai/keys, use a model with the :free suffix
# Any other OpenAI-compatible endpoint, or a local Ollama (NOVERA_LLM_PROVIDER=ollama, no key):
NOVERA_LLM_BASE_URL=
NOVERA_LLM_API_KEY=
# Model id for a single provider; empty means its default (claude-opus-5, gemini-3.6-flash, ...).
# Ignored for a chain, where each member uses its default or the model after its colon.
NOVERA_LLM_MODEL=

# Alerts: stored in the database always; delivered only if a channel is configured.
# WARNING: every `novera run eod` and the scheduler deliver for real once SMTP/Slack is filled in.
NOVERA_ALERTS_ENABLED=true
NOVERA_SLACK_WEBHOOK_URL=
NOVERA_SMTP_HOST=
NOVERA_SMTP_PORT=587
NOVERA_SMTP_USER=
NOVERA_SMTP_PASSWORD=
NOVERA_ALERT_EMAIL_FROM=
NOVERA_ALERT_EMAIL_TO=

# Scheduler: wall-clock time for the daily EOD run.
NOVERA_EOD_TIME=18:30

# Real market data (optional). FRED key is free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Counterparty risk.
NOVERA_EXPOSURE_ENABLED=true
NOVERA_EXPOSURE_PATHS=1000
NOVERA_OWN_CREDIT_SPREAD_BP=80
NOVERA_LGD=0.6
NOVERA_REGULATORY_ENABLED=true
